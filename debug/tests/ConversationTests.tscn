[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tests/ConversationTests.cs" id="1_tests"]
[ext_resource type="Script" path="res://narrative/CompanionChat.cs" id="2_companion"]
[ext_resource type="Script" path="res://ui/Hud.cs" id="3_hud"]

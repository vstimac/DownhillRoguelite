[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tests/UiTests.cs" id="1_tests"]
[ext_resource type="Script" path="res://terrain/TerrainStreamer.cs" id="2_streamer"]
[ext_resource type="Resource" path="res://terrain/default_terrain.tres" id="3_terrain_settings"]
[ext_resource type="PackedScene" path="res://player/Player.tscn" id="4_player"]
[ext_resource type="Script" path="res://inventory/CarrierInventory.cs" id="5_inventory"]
[ext_resource type="Resource" path="res://inventory/default_backpack.tres" id="6_backpack"]
[ext_resource type="Script" path="res://map/FieldMap.cs" id="7_map"]
[ext_resource type="Script" path="res://ui/Hud.cs" id="8_hud"]

[node name="UiTests" type="Node3D" node_paths=PackedStringArray("PlayerBody", "Streamer", "Ui", "Map")]
script = ExtResource("1_tests")
PlayerBody = NodePath("Player")
Streamer = NodePath("Terrain")
Ui = NodePath("Hud")
Map = NodePath("FieldMap")

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("2_streamer")

[sub_resource type="Resource" id="Boon_steady_legs"]
script = ExtResource("41_boon")
Id = "steady_legs"
DisplayName = "Steady Legs"
Description = "The pack sways less: balance is a fifth stronger."
Glow = Color(0.6, 0.85, 1.0, 1)
Balance = 1.2

[sub_resource type="Resource" id="Boon_iron_lungs"]
script = ExtResource("41_boon")
Id = "iron_lungs"
DisplayName = "Iron Lungs"
Description = "Rest comes quicker: stamina recovers a quarter faster."
Glow = Color(0.5, 1.0, 0.7, 1)
StaminaRecovery = 1.25

[sub_resource type="Resource" id="Boon_deep_reserves"]
script = ExtResource("41_boon")
Id = "deep_reserves"
DisplayName = "Deep Reserves"
Description = "More in the tank: a fifth more stamina."
Glow = Color(0.4, 0.8, 1.0, 1)
StaminaMax = 1.2

[sub_resource type="Resource" id="Boon_light_step"]
script = ExtResource("41_boon")
Id = "light_step"
DisplayName = "Light Step"
Description = "Walking costs 15 % less stamina."
Glow = Color(0.8, 1.0, 0.6, 1)
WalkDrain = 0.85

[sub_resource type="Resource" id="Boon_strong_back"]
script = ExtResource("41_boon")
Id = "strong_back"
DisplayName = "Strong Back"
Description = "The load's weight costs a fifth less stamina."
Glow = Color(1.0, 0.7, 0.4, 1)
LoadDrain = 0.8

[sub_resource type="Resource" id="Boon_lean_belly"]
script = ExtResource("41_boon")
Id = "lean_belly"
DisplayName = "Lean Belly"
Description = "Hunger and thirst grow 15 % slower."
Glow = Color(1.0, 0.85, 0.5, 1)
NeedsDrain = 0.85

[sub_resource type="Resource" id="Boon_thick_blood"]
script = ExtResource("41_boon")
Id = "thick_blood"
DisplayName = "Thick Blood"
Description = "A third of the cold can't reach you."
Glow = Color(1.0, 0.45, 0.35, 1)
ColdResistance = 0.33

[sub_resource type="Resource" id="Boon_sure_footing"]
script = ExtResource("41_boon")
Id = "sure_footing"
DisplayName = "Sure Footing"
Description = "Feet find purchase: 15 % more grip on any ground."
Glow = Color(0.75, 0.7, 0.6, 1)
Grip = 1.15

[sub_resource type="Resource" id="Boon_long_stride"]
script = ExtResource("41_boon")
Id = "long_stride"
DisplayName = "Long Stride"
Description = "You walk 8 % faster."
Glow = Color(0.6, 1.0, 1.0, 1)
WalkSpeed = 1.08

[sub_resource type="Resource" id="Boon_deep_sleep"]
script = ExtResource("41_boon")
Id = "deep_sleep"
DisplayName = "Deep Sleep"
Description = "A night's sleep heals half again as much."
Glow = Color(0.7, 0.6, 1.0, 1)
SleepHeal = 1.5

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sky"]
shader = ExtResource("25_sky_shader")
shader_parameter/top_color = Color(0.3, 0.36, 0.46, 1)
shader_parameter/horizon_color = Color(0.62, 0.62, 0.62, 1)
shader_parameter/ground_color = Color(0.12, 0.12, 0.13, 1)

[sub_resource type="Sky" id="Sky_main"]
sky_material = SubResource("ShaderMaterial_sky")
process_mode = 3
radiance_size = 3

[sub_resource type="Environment" id="Environment_main"]
background_mode = 2
sky = SubResource("Sky_main")
ambient_light_source = 3
reflected_light_source = 2
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.5, 0.51, 0.53, 1)
fog_density = 0.012
fog_sky_affect = 0.6
adjustment_enabled = true
adjustment_saturation = 0.55
adjustment_contrast = 1.05

[node name="TestTerrain" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.187303, 0.463592, 0.000000, 0.927184, 0.374607, -0.500000, -0.324419, 0.802965, 0, 100, 0)
light_color = Color(0.86, 0.88, 0.95, 1)
light_energy = 0.75
shadow_enabled = true
directional_shadow_max_distance = 120.0

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("14_streamer")
Settings = ExtResource("15_terrain_settings")
RandomSeedOnStart = true

[node name="DayNight" type="Node" parent="." node_paths=PackedStringArray("Sun", "World")]
script = ExtResource("20_daynight")
Sun = NodePath("../Sun")
World = NodePath("../WorldEnvironment")


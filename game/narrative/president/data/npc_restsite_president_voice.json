{
  "character": "Restsite President (fictional satire)",
  "language": "sr-RS",
  "variant_selector": "forest|outdoor",
  "lines": [
    {
      "id": "vucic_001",
      "key": "intro_stop",
      "context": "first_interaction",
      "text": "Stanite. Stanite, molim vas. Pre nego što nastavite, imam jednu veoma važnu vest.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_001_intro_stop.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_001_intro_stop.ogg"
      },
      "duration_seconds": {
        "forest": 5.969,
        "outdoor": 6.311
      }
    },
    {
      "id": "vucic_002",
      "key": "intro_restsite",
      "context": "first_interaction",
      "text": "Ovo je jedino odmorište na planini na kojem se pouzdano zna da smo napredovali.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_002_intro_restsite.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_002_intro_restsite.ogg"
      },
      "duration_seconds": {
        "forest": 4.874,
        "outdoor": 5.016
      }
    },
    {
      "id": "vucic_003",
      "key": "intro_descent",
      "context": "first_interaction",
      "text": "To vi tako kažete. Ali ako se sve oko vas pomera nagore, ko je onda zaista u pravu?",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_003_intro_descent.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_003_intro_descent.ogg"
      },
      "duration_seconds": {
        "forest": 6.062,
        "outdoor": 6.089
      }
    },
    {
      "id": "vucic_004",
      "key": "intro_responsibility",
      "context": "first_interaction",
      "text": "Ja sam odgovoran za ovo odmorište. Ne i za stanje na putu. To je vrlo važno da razumete.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_004_intro_responsibility.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_004_intro_responsibility.ogg"
      },
      "duration_seconds": {
        "forest": 6.515,
        "outdoor": 6.633
      }
    },
    {
      "id": "vucic_005",
      "key": "intro_stairs",
      "context": "first_interaction",
      "text": "Pitali su me zašto su stepenice iza mene zazidane. A ja pitam vas: ko je rekao da morate negde da stignete?",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_005_intro_stairs.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_005_intro_stairs.ogg"
      },
      "duration_seconds": {
        "forest": 7.019,
        "outdoor": 7.063
      }
    },
    {
      "id": "vucic_006",
      "key": "rest_offer",
      "context": "rest",
      "text": "Naravno. Odmor je strateška investicija. Samo nemojte da se opustite previše.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_006_rest_offer.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_006_rest_offer.ogg"
      },
      "duration_seconds": {
        "forest": 5.29,
        "outdoor": 5.541
      }
    },
    {
      "id": "vucic_007",
      "key": "quest_offer",
      "context": "quest_offer",
      "text": "Imam. I to posao od istorijskog značaja. Ne mogu da vam kažem koliko je značajan dok ga ne obavite.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_007_quest_offer.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_007_quest_offer.ogg"
      },
      "duration_seconds": {
        "forest": 6.562,
        "outdoor": 6.849
      }
    },
    {
      "id": "vucic_008",
      "key": "quest_warning",
      "context": "quest_offer",
      "text": "I treba da idete. Samo nemojte posle da kažete da vas nisam upozorio. Na šta tačno, to ćemo još utvrditi.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_008_quest_warning.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_008_quest_warning.ogg"
      },
      "duration_seconds": {
        "forest": 7.098,
        "outdoor": 7.171
      }
    },
    {
      "id": "vucic_009",
      "key": "quest_missing_records",
      "context": "quest_active",
      "text": "Imamo jedan ozbiljan problem. Rezultati postoje, ali nam nedostaju papiri koji to potvrđuju.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_009_quest_missing_records.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_009_quest_missing_records.ogg"
      },
      "duration_seconds": {
        "forest": 6.096,
        "outdoor": 5.996
      }
    },
    {
      "id": "vucic_010",
      "key": "quest_instructions",
      "context": "quest_active",
      "text": "To ćemo znati čim pronađete zapisnike. U međuvremenu, budite uvereni da je sve pod kontrolom.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_010_quest_instructions.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_010_quest_instructions.ogg"
      },
      "duration_seconds": {
        "forest": 6.128,
        "outdoor": 6.101
      }
    },
    {
      "id": "vucic_011",
      "key": "quest_accept",
      "context": "quest_accepted",
      "text": "Znao sam da mogu da računam na vas. Nisam znao ko ste do pre pola minuta, ali sam znao.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_011_quest_accept.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_011_quest_accept.ogg"
      },
      "duration_seconds": {
        "forest": 6.033,
        "outdoor": 5.901
      }
    },
    {
      "id": "vucic_012",
      "key": "quest_decline",
      "context": "quest_declined",
      "text": "Poštujem vašu odluku. Samo nemojte posle da kažete da niste imali priliku da učestvujete u istoriji.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_012_quest_decline.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_012_quest_decline.ogg"
      },
      "duration_seconds": {
        "forest": 6.031,
        "outdoor": 6.058
      }
    },
    {
      "id": "vucic_013",
      "key": "quest_review_records",
      "context": "quest_completed",
      "text": "Odlično. Dajte da vidim. Hm. Prvi zapisnik kaže jedno. Drugi kaže drugo. A treći ne kaže ništa.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_013_quest_review_records.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_013_quest_review_records.ogg"
      },
      "duration_seconds": {
        "forest": 8.634,
        "outdoor": 8.258
      }
    },
    {
      "id": "vucic_014",
      "key": "quest_announcement_intro",
      "context": "quest_completed",
      "text": "Dakle, svi preduslovi su ispunjeni za jedno veliko saopštenje.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_014_quest_announcement_intro.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_014_quest_announcement_intro.ogg"
      },
      "duration_seconds": {
        "forest": 4.271,
        "outdoor": 4.208
      }
    },
    {
      "id": "vucic_015",
      "key": "quest_announcement",
      "context": "quest_completed",
      "text": "Saopštavamo da još nemamo konačno saopštenje.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_015_quest_announcement.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_015_quest_announcement.ogg"
      },
      "duration_seconds": {
        "forest": 3.457,
        "outdoor": 3.417
      }
    },
    {
      "id": "vucic_016",
      "key": "quest_result",
      "context": "quest_completed",
      "text": "Znam ja rezultat. Samo rezultat još nije spreman da prizna samog sebe.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_016_quest_result.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_016_quest_result.ogg"
      },
      "duration_seconds": {
        "forest": 4.87,
        "outdoor": 4.736
      }
    },
    {
      "id": "vucic_017",
      "key": "quest_thanks",
      "context": "quest_completed",
      "text": "Hvala vam. Vaša podrška mi je veoma važna, naročito kada još ne znamo šta se tačno dogodilo.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_017_quest_thanks.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_017_quest_thanks.ogg"
      },
      "duration_seconds": {
        "forest": 6.177,
        "outdoor": 5.943
      }
    },
    {
      "id": "vucic_018",
      "key": "idle_few_words",
      "context": "idle",
      "text": "Vidim da ste čovek od malo reči. To je pametno. Manje toga može da se proveri.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_018_idle_few_words.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_018_idle_few_words.ogg"
      },
      "duration_seconds": {
        "forest": 4.858,
        "outdoor": 4.86
      }
    },
    {
      "id": "vucic_019",
      "key": "rest_warm_drink",
      "context": "rest",
      "text": "Sedite. Popijte nešto toplo. Ovde je opasno samo ako odlučite da nastavite.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_019_rest_warm_drink.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_019_rest_warm_drink.ogg"
      },
      "duration_seconds": {
        "forest": 5.398,
        "outdoor": 5.16
      }
    },
    {
      "id": "vucic_020",
      "key": "shop_welcome",
      "context": "shop",
      "text": "Dobro došli u Privremene mere. Sve što vam prodajem ima trajnu cenu i privremeno dejstvo.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_020_shop_welcome.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_020_shop_welcome.ogg"
      },
      "duration_seconds": {
        "forest": 6.136,
        "outdoor": 6.233
      }
    },
    {
      "id": "vucic_021",
      "key": "shop_no_purchase",
      "context": "shop",
      "text": "Ako niste kupili ništa, i to je doprinos lokalnoj privredi. Bar statistički.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_021_shop_no_purchase.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_021_shop_no_purchase.ogg"
      },
      "duration_seconds": {
        "forest": 4.857,
        "outdoor": 4.914
      }
    },
    {
      "id": "vucic_022",
      "key": "goodbye",
      "context": "departure",
      "text": "Srećan put. I nemojte da se osvrćete. Ova tribina mnogo lepše izgleda iz daljine.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_022_goodbye.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_022_goodbye.ogg"
      },
      "duration_seconds": {
        "forest": 5.316,
        "outdoor": 5.38
      }
    },
    {
      "id": "vucic_023",
      "key": "return_visit",
      "context": "return",
      "text": "Opet ste tu? To sam i očekivao. Ne mogu da kažem zašto, ali jesam.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_023_return_visit.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_023_return_visit.ogg"
      },
      "duration_seconds": {
        "forest": 4.898,
        "outdoor": 4.918
      }
    },
    {
      "id": "vucic_024",
      "key": "return_after_death",
      "context": "death_return",
      "text": "Čujem da ste pali. Ja to ne bih tako nazvao. To je bilo kontrolisano upoznavanje terena.",
      "audio": {
        "forest": "res://audio/voice/npc_restsite_president/forest/vucic_024_return_after_death.ogg",
        "outdoor": "res://audio/voice/npc_restsite_president/outdoor/vucic_024_return_after_death.ogg"
      },
      "duration_seconds": {
        "forest": 7.079,
        "outdoor": 6.977
      }
    }
  ]
}
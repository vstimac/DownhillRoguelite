[gd_scene format=3]

[ext_resource type="PackedScene" path="res://debug/TestTerrain.tscn" id="1_world"]
[ext_resource type="Script" path="res://progression/expeditions/RecoveryExpedition.cs" id="2_expedition"]
[ext_resource type="Resource" path="res://progression/contracts/resources/recover_pump.tres" id="3_job"]

[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tests/LoreTests.cs" id="1_tests"]
[ext_resource type="Script" path="res://terrain/TerrainStreamer.cs" id="2_streamer"]
[ext_resource type="Resource" path="res://terrain/default_terrain.tres" id="3_terrain_settings"]
[ext_resource type="PackedScene" path="res://player/Player.tscn" id="4_player"]
[ext_resource type="Script" path="res://map/StationManager.cs" id="5_stations"]
[ext_resource type="Script" path="res://narrative/LorePlacer.cs" id="6_lore"]
[ext_resource type="Script" path="res://debug/DebugSceneControls.cs" id="7_controls"]

[node name="LoreTests" type="Node3D" node_paths=PackedStringArray("PlayerBody", "Streamer", "Stations", "Lore")]
script = ExtResource("1_tests")
PlayerBody = NodePath("Player")
Streamer = NodePath("Terrain")
Stations = NodePath("Stations")
Lore = NodePath("Lore")

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("2_streamer")
Settings = ExtResource("3_terrain_settings")

[node name="Stations" type="Node3D" parent="."]
script = ExtResource("5_stations")

[node name="Lore" type="Node3D" parent="."]
script = ExtResource("6_lore")

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="Controls" type="Node" parent="." node_paths=PackedStringArray("PlayerBody", "Streamer")]
script = ExtResource("7_controls")
KillHeight = -1e+09
PlayerBody = NodePath("../Player")
Streamer = NodePath("../Terrain")

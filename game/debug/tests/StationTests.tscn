[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tests/StationTests.cs" id="1_tests"]
[ext_resource type="Script" path="res://terrain/TerrainStreamer.cs" id="2_streamer"]
[ext_resource type="Resource" path="res://terrain/default_terrain.tres" id="3_terrain_settings"]
[ext_resource type="PackedScene" path="res://player/Player.tscn" id="4_player"]
[ext_resource type="Script" path="res://inventory/CarrierInventory.cs" id="5_inventory"]
[ext_resource type="Resource" path="res://inventory/default_backpack.tres" id="6_backpack"]
[ext_resource type="Script" path="res://inventory/world/SupplySpawner.cs" id="7_supplies"]
[ext_resource type="Resource" path="res://inventory/world/default_supplies.tres" id="8_table"]
[ext_resource type="Script" path="res://map/StationManager.cs" id="9_stations"]
[ext_resource type="Script" path="res://environment/DayNightCycle.cs" id="10_daynight"]
[ext_resource type="Script" path="res://inventory/interaction/PackingMode.cs" id="11_packing"]

[sub_resource type="ProceduralSkyMaterial" id="Sky_material"]

[sub_resource type="Sky" id="Sky_main"]
sky_material = SubResource("Sky_material")

[sub_resource type="Environment" id="Environment_main"]
background_mode = 2
sky = SubResource("Sky_main")
fog_enabled = true
fog_density = 0.012

[node name="StationTests" type="Node3D" node_paths=PackedStringArray("PlayerBody", "Streamer", "Stations", "DayNight", "Packing")]
script = ExtResource("1_tests")
PlayerBody = NodePath("Player")
Streamer = NodePath("Terrain")
Stations = NodePath("Stations")
DayNight = NodePath("DayNight")
Packing = NodePath("Packing")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

[node name="Sun" type="DirectionalLight3D" parent="."]

[node name="DayNight" type="Node" parent="." node_paths=PackedStringArray("Sun", "World")]
script = ExtResource("10_daynight")
Sun = NodePath("../Sun")
World = NodePath("../WorldEnvironment")

[node name="Stations" type="Node3D" parent="."]
script = ExtResource("9_stations")

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("2_streamer")
Settings = ExtResource("3_terrain_settings")

[node name="Supplies" type="Node3D" parent="."]
script = ExtResource("7_supplies")
Table = ExtResource("8_table")

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="Inventory" type="Node" parent="Player"]
script = ExtResource("5_inventory")
Backpack = ExtResource("6_backpack")
StartingItemPaths = PackedStringArray()
AutoPackOnStart = false

[node name="Packing" type="Node3D" parent="." node_paths=PackedStringArray("Inventory", "PlayerBody")]
script = ExtResource("11_packing")
Inventory = NodePath("../Player/Inventory")
PlayerBody = NodePath("../Player")

[ext_resource type="Script" path="res://narrative/president/PresidentDirector.cs" id="8_president"]

[node name="PresidentTests" type="Node3D" node_paths=PackedStringArray("PlayerBody", "Streamer", "Director")]
script = ExtResource("1_tests")
PlayerBody = NodePath("Player")
Streamer = NodePath("Terrain")
Director = NodePath("President")

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("2_streamer")
Settings = ExtResource("3_terrain_settings")

[node name="Stations" type="Node3D" parent="."]
script = ExtResource("7_stations")

[node name="President" type="Node3D" parent="."]
script = ExtResource("8_president")
PersistentSave = false

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="Inventory" type="Node" parent="Player"]
script = ExtResource("5_inventory")
Backpack = ExtResource("6_backpack")
StartingItemPaths = PackedStringArray()
AutoPackOnStart = false

[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tests/PresidentTests.cs" id="1_tests"]
[ext_resource type="Script" path="res://terrain/TerrainStreamer.cs" id="2_streamer"]
[ext_resource type="Resource" path="res://terrain/default_terrain.tres" id="3_terrain_settings"]
[ext_resource type="PackedScene" path="res://player/Player.tscn" id="4_player"]
[ext_resource type="Script" path="res://inventory/CarrierInventory.cs" id="5_inventory"]
[ext_resource type="Resource" path="res://inventory/default_backpack.tres" id="6_backpack"]

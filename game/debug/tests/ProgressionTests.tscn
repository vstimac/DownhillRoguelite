[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tests/ProgressionTests.cs" id="1_tests"]
[ext_resource type="Script" path="res://terrain/TerrainStreamer.cs" id="2_streamer"]
[ext_resource type="Resource" path="res://terrain/default_terrain.tres" id="3_terrain_settings"]
[ext_resource type="PackedScene" path="res://player/Player.tscn" id="4_player"]
[ext_resource type="Script" path="res://inventory/CarrierInventory.cs" id="5_inventory"]
[ext_resource type="Resource" path="res://inventory/default_backpack.tres" id="6_backpack"]
[ext_resource type="Script" path="res://map/StationManager.cs" id="7_stations"]
[ext_resource type="Script" path="res://progression/BoonOfferings.cs" id="8_boons"]
[ext_resource type="Script" path="res://progression/BoonDefinition.cs" id="9_boon"]
[ext_resource type="Script" path="res://progression/StartingKit.cs" id="10_kit"]
[ext_resource type="Script" path="res://debug/DebugSceneControls.cs" id="11_controls"]

[sub_resource type="Resource" id="Boon_steady_legs"]
script = ExtResource("9_boon")
Id = "steady_legs"
DisplayName = "Steady Legs"
Description = "The pack sways less: balance is a fifth stronger."
Glow = Color(0.6, 0.85, 1.0, 1)
Balance = 1.2

[sub_resource type="Resource" id="Boon_iron_lungs"]
script = ExtResource("9_boon")
Id = "iron_lungs"
DisplayName = "Iron Lungs"
Description = "Rest comes quicker: stamina recovers a quarter faster."
Glow = Color(0.5, 1.0, 0.7, 1)
StaminaRecovery = 1.25

[sub_resource type="Resource" id="Boon_deep_reserves"]
script = ExtResource("9_boon")
Id = "deep_reserves"
DisplayName = "Deep Reserves"
Description = "More in the tank: a fifth more stamina."
Glow = Color(0.4, 0.8, 1.0, 1)
StaminaMax = 1.2

[sub_resource type="Resource" id="Boon_light_step"]
script = ExtResource("9_boon")
Id = "light_step"
DisplayName = "Light Step"
Description = "Walking costs 15 % less stamina."
Glow = Color(0.8, 1.0, 0.6, 1)
WalkDrain = 0.85

[sub_resource type="Resource" id="Boon_strong_back"]
script = ExtResource("9_boon")
Id = "strong_back"
DisplayName = "Strong Back"
Description = "The load's weight costs a fifth less stamina."
Glow = Color(1.0, 0.7, 0.4, 1)
LoadDrain = 0.8

[sub_resource type="Resource" id="Boon_lean_belly"]
script = ExtResource("9_boon")
Id = "lean_belly"
DisplayName = "Lean Belly"
Description = "Hunger and thirst grow 15 % slower."
Glow = Color(1.0, 0.85, 0.5, 1)
NeedsDrain = 0.85

[sub_resource type="Resource" id="Boon_thick_blood"]
script = ExtResource("9_boon")
Id = "thick_blood"
DisplayName = "Thick Blood"
Description = "A third of the cold can't reach you."
Glow = Color(1.0, 0.45, 0.35, 1)
ColdResistance = 0.33

[sub_resource type="Resource" id="Boon_sure_footing"]
script = ExtResource("9_boon")
Id = "sure_footing"
DisplayName = "Sure Footing"
Description = "Feet find purchase: 15 % more grip on any ground."
Glow = Color(0.75, 0.7, 0.6, 1)
Grip = 1.15

[sub_resource type="Resource" id="Boon_long_stride"]
script = ExtResource("9_boon")
Id = "long_stride"
DisplayName = "Long Stride"
Description = "You walk 8 % faster."
Glow = Color(0.6, 1.0, 1.0, 1)
WalkSpeed = 1.08

[sub_resource type="Resource" id="Boon_deep_sleep"]
script = ExtResource("9_boon")
Id = "deep_sleep"
DisplayName = "Deep Sleep"
Description = "A night's sleep heals half again as much."
Glow = Color(0.7, 0.6, 1.0, 1)
SleepHeal = 1.5

[node name="ProgressionTests" type="Node3D" node_paths=PackedStringArray("PlayerBody", "Streamer", "Offerings", "Kit")]
script = ExtResource("1_tests")
PlayerBody = NodePath("Player")
Streamer = NodePath("Terrain")
Offerings = NodePath("Boons")
Kit = NodePath("StartingKit")

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("2_streamer")
Settings = ExtResource("3_terrain_settings")

[node name="Stations" type="Node3D" parent="."]
script = ExtResource("7_stations")

[node name="Boons" type="Node3D" parent="."]
script = ExtResource("8_boons")
Boons = [SubResource("Boon_steady_legs"), SubResource("Boon_iron_lungs"), SubResource("Boon_deep_reserves"), SubResource("Boon_light_step"), SubResource("Boon_strong_back"), SubResource("Boon_lean_belly"), SubResource("Boon_thick_blood"), SubResource("Boon_sure_footing"), SubResource("Boon_long_stride"), SubResource("Boon_deep_sleep")]

[node name="StartingKit" type="Node" parent="."]
script = ExtResource("10_kit")

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="Inventory" type="Node" parent="Player"]
script = ExtResource("5_inventory")
Backpack = ExtResource("6_backpack")
StartingItemPaths = PackedStringArray()
AutoPackOnStart = false

[node name="Controls" type="Node" parent="." node_paths=PackedStringArray("PlayerBody", "Streamer")]
script = ExtResource("11_controls")
KillHeight = -1e+09
PlayerBody = NodePath("../Player")
Streamer = NodePath("../Terrain")

ScenePath = "res://debug/TestActiveRagdoll.tscn"
Description = "Hibrid: hodanje i IK, opruzna korekcija kukova i slobodnih ruku, kratka fizicka napetost ruku pri padu. Gumbi za udarce, pad, nagib i A/B usporedbu."
Controls = "Gumbi za udarce i A/B | WASD | Shift | C | Space | Ctrl | F3 dijagnostika | F10 izbornik"


<Project Sdk="Microsoft.NET.Sdk">
  <!--
    "Let's Play" launcher for Downhill Roguelite: one small Windows exe that installs the newest
    build from GitHub, keeps it up to date and starts the game. Build:
      dotnet publish tools/launcher/LetsPlay.csproj -c Release -o tools/launcher/out
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lets-Play-Downhill-Roguelite</AssemblyName>
    <RootNamespace>LetsPlay</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Product>Downhill Roguelite</Product>
    <Title>Let's Play: Downhill Roguelite</Title>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>

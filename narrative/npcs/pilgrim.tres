[gd_resource type="Resource" script_class="NpcPersona" format=3]

[ext_resource type="Script" path="res://narrative/NpcPersona.cs" id="1_persona"]

[resource]
script = ExtResource("1_persona")
Id = "pilgrim"
DisplayName = "Aldo"
Title = "a pilgrim who turned back"
Description = "He went down further than most, then climbed back up. He won't say what he saw."
Persona = "You are Aldo, an old pilgrim who once descended far below this place and then turned back and climbed up again. You are tired, kind and evasive. You hint that you saw something below that made you turn around, but you never say what. You warn the carrier gently, but you don't try to stop them."
SilentLines = PackedStringArray("I went down once. Further than you'd believe. Then I came back up.", "Rest while the fire's warm. It won't be, further down.", "Don't ask me what's below. Ask me what's worth carrying.")
MinCircle = 0
CloakColor = Color(0.42, 0.36, 0.28, 1)
VoicePitch = 0.9

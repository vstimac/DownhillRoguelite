# Godot generated cache
.godot/
.mono/

# .NET build output
bin/
obj/
*.user

# IDEs
.vs/
.idea/

# Local development tooling (kept out of the repository)
.claude/
CLAUDE.md

# NobodyWho prebuilt libraries (~140 MB each, over GitHub's 100 MB file limit).
# Reinstall the addon to restore them; see addons/README.md.
game/addons/nobodywho/*.dll
game/addons/nobodywho/*.pdb
game/addons/nobodywho/*.so
game/addons/nobodywho/*.dylib
# Leftover copies Windows makes of locked DLLs
game/addons/**/~*
game/tools/launcher/bin/
game/tools/launcher/obj/
game/tools/launcher/out/

# Mixamo character and animations: free to use in the game, not to redistribute as files (see game/art/characters/mixamo/README.md)
game/art/characters/mixamo/*.fbx
game/art/characters/mixamo/*.fbx.import
game/art/characters/mixamo/*.png
game/art/characters/mixamo/*.png.import
game/art/characters/mixamo_sword/*.fbx
game/art/characters/mixamo_sword/*.fbx.import

# Linux export output (scripts/build_linux.sh)
build/
.ci/

# Python bytecode from the audio tools
__pycache__/

# Godot generated cache
.godot/
.mono/

# .NET build output
bin/
obj/
*.user

# IDEs
.vs/
.idea/

# Claude Code per-user settings
.claude/settings.local.json

# NobodyWho prebuilt libraries (~140 MB each, over GitHub's 100 MB file limit).
# Reinstall the addon to restore them; see addons/README.md.
addons/nobodywho/*.dll
addons/nobodywho/*.pdb
addons/nobodywho/*.so
addons/nobodywho/*.dylib
# Leftover copies Windows makes of locked DLLs
addons/**/~*
tools/launcher/bin/
tools/launcher/obj/
tools/launcher/out/

# Mixamo character and animations: free to use in the game, not to redistribute as files (see art/characters/mixamo/README.md)
art/characters/mixamo/*.fbx
art/characters/mixamo/*.fbx.import
art/characters/mixamo/*.png
art/characters/mixamo/*.png.import

# Linux export output (scripts/build_linux.sh)
build/
.ci/
